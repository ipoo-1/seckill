# 复制为 .env，并按本机环境修改。不要把 .env 提交到 Git。
DB_URL=jdbc:mysql://localhost:3306/seckill?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=seckill-producer-group
ROCKETMQ_CONSUMER_GROUP=seckill-consumer-group
ROCKETMQ_ORDER_TOPIC=seckill-order

ELASTICSEARCH_URIS=http://localhost:9200

SECKILL_RATE_LIMIT_PER_SECOND=2000
SECKILL_RESERVATION_TTL_SECONDS=604800
SECKILL_STOCK_TTL_SECONDS=86400

OUTBOX_BATCH_SIZE=50
OUTBOX_FIXED_DELAY_MS=1000
OUTBOX_MAX_RETRY=8
OUTBOX_REPUBLISH_AFTER_SECONDS=300
